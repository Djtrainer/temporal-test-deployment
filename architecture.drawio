                <mxCell id="mt_dev_x_container" value="container: api&#10;&#10;uvicorn (one process):&#10;  • FastAPI endpoints&#10;  • Worker (lifespan)&#10;&#10;TEMPORAL_TASK_QUEUE=dev-x&#10;TEMPORAL_TLS=true" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;strokeWidth=1;verticalAlign=top;fontSize=9;fontFamily=Courier New;align=left;spacingLeft=6;spacingTop=4;fontColor=#1A1A1A;" parent="1" vertex="1">
