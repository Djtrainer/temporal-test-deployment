                <mxCell id="mt_flags" value="Non-negotiable Cloud Run flags for embedded-worker pattern:&#10;• --min-instances=1   →   worker must keep polling between requests&#10;• --no-cpu-throttling →  worker needs CPU when no request is being served" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FCE8E6;strokeColor=#EA4335;strokeWidth=1;dashed=0;verticalAlign=middle;fontSize=10;fontStyle=0;align=left;spacingLeft=10;fontColor=#1A1A1A;" parent="1" vertex="1">
