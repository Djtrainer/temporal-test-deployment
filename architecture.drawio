                <mxCell id="mt_dev_y_container" value="native python (one process):&#10;  • FastAPI endpoints&#10;  • Worker (lifespan)&#10;&#10;TEMPORAL_TASK_QUEUE=dev-y&#10;TEMPORAL_TLS=true&#10;&#10;hot-reload on file change" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;strokeWidth=1;verticalAlign=top;fontSize=9;fontFamily=Courier New;align=left;spacingLeft=6;spacingTop=4;fontColor=#1A1A1A;" parent="1" vertex="1">
                    <mxGeometry x="500" y="720" width="230" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="mt_lifecycle" value="Lifecycle&#10;&#10;1.  Clone template repo&#10;     temporal-test-api-deployment&#10;&#10;2.  Pick TEMPORAL_TASK_QUEUE&#10;     (unique per tenant/app)&#10;&#10;3.  Iterate locally:&#10;     docker compose -f .gcp.yml up&#10;&#10;4.  Ship:&#10;     gcloud builds submit + run deploy&#10;&#10;Same image, same env vars, both modes." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1;dashed=0;verticalAlign=top;fontSize=10;fontStyle=0;align=left;spacingLeft=10;spacingTop=6;fontColor=#1A1A1A;" parent="1" vertex="1">
                    <mxGeometry x="780" y="660" width="320" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="mt_tq_note" value="Task-queue isolation&#10;&#10;Each tenant picks a unique&#10;TEMPORAL_TASK_QUEUE name.&#10;Workers only poll their own&#10;queue, so tenants never see&#10;each other's workflows.&#10;&#10;Namespace can be shared&#10;(default) or per-tenant." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1;dashed=0;verticalAlign=top;fontSize=10;fontStyle=0;align=left;spacingLeft=10;spacingTop=6;fontColor=#1A1A1A;" parent="1" vertex="1">
                    <mxGeometry x="1120" y="660" width="320" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="mt_e_a" value="task_queue: tenant-A&#10;gRPC over TLS :443" style="endArrow=classic;html=1;strokeColor=#1A73E8;strokeWidth=2;fontSize=9;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.25;entryX=1;entryY=0.25;fontColor=#1A1A1A;" parent="1" source="mt_tenant_a" target="mt_server" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
